# Set a long random secret before starting the API.
JWT_SECRET=replace-with-a-random-secret
DATABASE_URL=postgresql+psycopg://mydawndiary:password@localhost:5432/mydawndiary

# Per direct client address, per minute. Keep one API worker unless the
# reverse proxy enforces shared limits across workers.
REQUESTS_PER_MINUTE=120
AUTH_REQUESTS_PER_MINUTE=10
ALERT_REQUESTS_PER_MINUTE=300
ALERT_COOLDOWN_MINUTES=15

# Optional email alert: use a Resend API key or the SMTP fields below.
# Set ALERT_EMAIL_FROM to a sender on a verified domain and ALERT_EMAIL_TO
# to the recipients. Keep credentials in the server environment.
RESEND_API_KEY=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
